{
  "name": "beadscope",
  "version": "0.5.1",
  "description": "A local web UI for the beads (bd) issue tracker",
  "keywords": [
    "beads",
    "bd",
    "issue-tracker",
    "kanban",
    "local-first",
    "nextjs",
    "cli"
  ],
  "homepage": "https://github.com/sai-manoj-kumar/beadscope#readme",
  "bugs": {
    "url": "https://github.com/sai-manoj-kumar/beadscope/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sai-manoj-kumar/beadscope.git"
  },
  "license": "MIT",
  "author": "Sai Manoj Kumar Yadlapati",
  "bin": {
    "beadscope": "bin/beadscope.mjs"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/types",
    "!.next/trace*",
    "!.next/diagnostics",
    "public",
    "next.config.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "serve": "node scripts/serve.mjs",
    "lint": "eslint",
    "prepack": "next build"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@base-ui/react": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.101.0",
    "@xyflow/react": "^12.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.20.0",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^9.1.0",
    "recharts": "^2.15.4",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "playwright": "^1.61.0",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.15",
    "sharp": "^0.35.5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.4",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.9",
      "onFail": "warn"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
